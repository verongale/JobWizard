# Copia questo file in .env.local e riempi i valori reali.
# .env.local è ignorato da Git: non committare MAI credenziali reali.

# Stringa di connessione PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobwizard"
GOOGLE_PLACES_API_KEY=la_tua_chiave_qui
GEMINI_API_KEY=la_tua_chiave_qui